{
  "name": "ngx-mat-hijri-adapter",
  "version": "0.0.0",
  "description": "Workspace for the Angular Material Umm al-Qura date adapter.",
  "scripts": {
    "ng": "ng",
    "start": "ng serve demo",
    "build": "node scripts/check-entry-boundaries.mjs && node scripts/stage-package-files.mjs && ng build ngx-mat-hijri-adapter",
    "build:demo": "ng build demo",
    "watch": "ng build ngx-mat-hijri-adapter --watch --configuration development",
    "test": "ng test ngx-mat-hijri-adapter --watch=false",
    "test:demo": "ng test demo --watch=false"
  },
  "private": true,
  "license": "MIT",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahmoudTarek44/ngx-mat-hijri-adapter.git"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@angular/material": "^22.2.1",
    "@internationalized/date": "^3.12.4",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
