{
  "name": "ngx-mat-hijri-adapter",
  "version": "0.4.4",
  "description": "Modern Angular Material date adapter for Gregorian and Umm al-Qura Hijri calendars, powered by @internationalized/date.",
  "author": "Mahmoud",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MahmoudTarek44/ngx-mat-hijri-adapter.git"
  },
  "homepage": "https://ngx-mat-hijri-adapter.dev/",
  "bugs": {
    "url": "https://github.com/MahmoudTarek44/ngx-mat-hijri-adapter/issues"
  },
  "keywords": [
    "angular",
    "angular-material",
    "datepicker",
    "date-adapter",
    "calendar",
    "hijri",
    "umalqura",
    "umm-al-qura",
    "islamic-calendar",
    "arabic",
    "signal-forms"
  ],
  "sideEffects": false,
  "schematics": "./schematics/collection.json",
  "ng-add": {
    "save": "dependencies"
  },
  "ng-update": {
    "migrations": "./schematics/migration-collection.json"
  },
  "peerDependencies": {
    "@angular/cdk": "^22.0.0",
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/material": "^22.0.0",
    "@internationalized/date": "^3.12.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  }
}
