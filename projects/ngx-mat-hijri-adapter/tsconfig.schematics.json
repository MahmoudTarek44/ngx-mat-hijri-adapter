{
  "compilerOptions": {
    "declaration": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmitOnError": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "strict": true,
    "rootDir": "schematics",
    "outDir": "../../dist/ngx-mat-hijri-adapter/schematics",
    "skipLibCheck": true,
    "sourceMap": true,
    "target": "ES2022",
    "types": []
  },
  "include": ["schematics/**/*.ts"],
  "exclude": ["schematics/**/*.spec.ts"]
}
